{
  "name": "beat-mania-engine",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsx scripts/generate-snapshot.ts && node -e \"require('fs').accessSync('dist/index.html'); require('fs').accessSync('dist/engine.snapshot.json')\"",
